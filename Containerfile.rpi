# Raspberry Pi 5 specifics: firmware, device trees, the sync hook.
#
# FROM the generic aarch64 bootc base (Containerfile.base). Everything here
# is about the VideoCore firmware boot chain: relocating linux-rpi's device
# trees and raspberrypi-bootloader's VideoCore blobs out of /boot (which
# bootc requires empty), vendoring the sync hook that mirrors each ostree
# deployment onto the firmware partition, and emptying /boot for good.
#
# Depends on:
#   localhost/archlinux-rpi-base:latest   (Containerfile.base)
# Build with:
#   podman build -f Containerfile.rpi -t localhost/archlinux-rpi:latest .

FROM localhost/archlinux-rpi-base:latest

# raspberrypi-utils: vcmailbox (tryboot flag) and vcgencmd.
# firmware-raspberrypi: CYW43455 (Pi 5 wifi/BT, on SDIO) blobs.
# wireless-regdb: regulatory domain data, needed for the wifi radio to
#   actually transmit under a country code instead of staying passive-scan.
# jq: the sync hook parses `bootc status --format json` with it.
RUN --mount=type=tmpfs,dst=/tmp \
    --mount=type=cache,dst=/usr/lib/sysimage/cache/pacman \
    pacman -Syu --needed --noconfirm \
        firmware-raspberrypi \
        jq \
        raspberrypi-bootloader \
        raspberrypi-utils \
        wireless-regdb

# Relocate dtbs/overlays out of /boot into the same versioned
# /usr/lib/modules/$kver/ directory the kernel and initramfs already live
# in, so the dtb set can never drift from the kernel it was built against
# across an upgrade or rollback. This is the one line the vendored sync
# hook (below) was patched for -- see its own header comment and
# docs/port-spec.md part D.
RUN kver="$(ls /usr/lib/modules)" && \
    mkdir -p "/usr/lib/modules/${kver}/dtbs/overlays" && \
    cp /boot/*.dtb "/usr/lib/modules/${kver}/dtbs/" && \
    cp /boot/overlays/*.dtbo "/usr/lib/modules/${kver}/dtbs/overlays/"

# VideoCore blobs are a package-level artifact, not versioned with the
# kernel -- the sync hook never reads this path, seed-firmware.sh does, at
# disk-image build time.
RUN mkdir -p /usr/lib/raspberrypi/boot && \
    cp /boot/bootcode.bin /boot/start*.elf /boot/fixup*.dat /usr/lib/raspberrypi/boot/

# No ALARM package ships this. The sync hook reads it, if present, as the
# per-slot include for [pi5]-only settings; leave it minimal, real
# per-board tuning happens by editing config-bootc-common.txt on the
# firmware partition instead (see scripts/rpi-disk-image/seed-firmware.sh).
RUN kver="$(ls /usr/lib/modules)" && \
    printf '%s\n' \
        '# Per-slot firmware config. Edit config-bootc-common.txt on the' \
        '# firmware partition for board-wide settings instead of this file.' \
        > "/usr/lib/modules/${kver}/rpi-config.txt"

# Static default kargs (docs/kernel-layout.md decision 3): no hardcoded
# root=, bootc/ostree supplies that from the BLS entry.
#
# No console= at all, deliberately, matching AlmaLinux's working image --
# their cmdline.txt is just root=, rw, boot= and ostree=. Two earlier
# attempts here were wrong: console=serial0,115200 alone sent every kernel
# message to the UART and left HDMI black, and adding console=tty1 did not
# help either, because this kernel builds DRM as a module and has no
# simpledrm built in, so there is no framebuffer console at all until the
# real root is mounted and modules load. HDMI silence during early boot is
# therefore normal here and says nothing about whether the kernel is
# running -- do not read it as a failure, and do not diagnose this board
# over HDMI. Use ethernet or a UART adapter.
RUN install -d /usr/lib/bootc/kargs.d && \
    printf '%s\n' \
        'kargs = ["rootwait"]' \
        > /usr/lib/bootc/kargs.d/10-rpi-kargs.toml

COPY docs/rpi-bootc-bootloader.arch-proposed /usr/bin/rpi-bootc-bootloader
COPY docs/rpi-bootc-bootloader.service.arch-proposed /usr/lib/systemd/system/ostree-finalize-staged.service.d/rpi-bootc-bootloader.conf
RUN chmod 0755 /usr/bin/rpi-bootc-bootloader && \
    bash -n /usr/bin/rpi-bootc-bootloader

# bootc requires /boot empty in the committed image; everything worth
# keeping from it was relocated above.
RUN rm -rf /boot/*

LABEL org.opencontainers.image.source="https://github.com/oci-native/archlinux-rpi"

# --skip var-tmpfiles --skip utf8: bootc-dev/bootc#1481, still open.
# ENOSYS under qemu-user emulation (host is x86_64). Re-run unskipped on
# real Pi hardware once it exists.
RUN bootc container lint --skip var-tmpfiles --skip utf8
