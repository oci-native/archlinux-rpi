# aarch64 bootc base: kernel, dracut initramfs, ostree layout.
#
# Sibling of /home/bupd/Projects/archlinux/Containerfile.base, adapted per
# docs/TEAM-BRIEF.md and STATUS.md. linux-rpi lives here (not in
# Containerfile.rpi) since this repo's only aarch64 target is the Pi.
# Everything specific to the Pi's firmware boot chain -- dtb relocation,
# VideoCore blobs, the sync hook -- is Containerfile.rpi's job instead,
# built FROM this image's tag.
#
# Depends on two images already built locally:
#   localhost/bootc-aarch64-builder:v1.16.10   (Containerfile.bootc)
#   localhost/archlinux-arm-base:latest        (Containerfile.rootfs)
# Build with:
#   podman build -f Containerfile.base -t localhost/archlinux-rpi-base:latest .

FROM --platform=$BUILDPLATFORM localhost/bootc-aarch64-builder:v1.16.10 AS bootc-builder

FROM --platform=linux/arm64 localhost/archlinux-arm-base:latest AS system

# Keep pacman's mutable database and cache outside the image-managed /usr
# deployment, same convention Containerfile.base (x86_64) uses, so pacman
# stays usable inside an explicit `bootc usr-overlay`.
RUN grep "= */var" /etc/pacman.conf | \
        sed "/= *\/var/s/.*=// ; s/ //" | \
        xargs -n1 sh -c \
            'mkdir -p "/usr/lib/sysimage/$(dirname "$(printf %s "$1" | sed "s@/var/@@")")"; mv -v "$1" "/usr/lib/sysimage/$(printf %s "$1" | sed "s@/var/@@")"' '' && \
    sed -i \
        -e "/= *\/var/ s/^#//" \
        -e "s@= */var@= /usr/lib/sysimage@g" \
        -e "/DownloadUser/d" \
        /etc/pacman.conf

# linux-rpi, not linux-rpi-16k: 16K pages break ELF alignment assumptions
# in QEMU/KVM/Wine/Box86/Chromium, and this box runs arbitrary aarch64
# container images as a container host. See docs/kernel-choice.md.
#
# skopeo and bubblewrap aren't on Prasanth's explicit package list, but
# both are real runtime deps, not extras: ostree-ext shells out to `skopeo
# experimental-image-proxy` for every registry pull, so `bootc
# upgrade`/`switch` needs it; bubblewrap sandboxes ostree deployment
# postprocessing. glib2/openssl/zstd are the shared libs bootc itself
# links against at runtime.
RUN --mount=type=tmpfs,dst=/tmp \
    --mount=type=cache,dst=/usr/lib/sysimage/cache/pacman \
    pacman -Sy --needed --noconfirm \
        base \
        bubblewrap \
        cpio \
        dbus \
        dracut \
        dosfstools \
        e2fsprogs \
        glib2 \
        linux-rpi \
        networkmanager \
        openssh \
        openssl \
        ostree \
        podman \
        skopeo \
        sudo \
        systemd \
        zstd

COPY --from=bootc-builder /output /

RUN chmod 4755 /usr/bin/newuidmap && \
    chmod 4755 /usr/bin/newgidmap

# linux-rpi puts the real kernel at /boot/kernel8.img and a zero-byte
# *placeholder* at /usr/lib/modules/$kver/vmlinuz -- the exact path
# bootc/ostree read as "the kernel." Fix it now, before Containerfile.rpi
# relocates the rest of /boot and empties it.
RUN kver="$(ls /usr/lib/modules)" && \
    test -s /boot/kernel8.img && \
    install -m644 /boot/kernel8.img "/usr/lib/modules/${kver}/vmlinuz"

# dracut CONFIG only. The initramfs itself is built much later, after
# prepare-root.conf exists -- see the dracut run near the end of this file.
#
# force_drivers sdhci-of-dwcmshc is what lets a Pi 5 find its root disk.
# The Pi 5's SD node is compatible = "raspberrypi,rp1-dwcmshc", driven by
# sdhci-of-dwcmshc, and this kernel builds that as a MODULE -- whereas the
# Pi 4's sdhci-iproc and sdhci-brcmstb are builtin (check
# modules.builtin). So on a Pi 5 the root device cannot appear until the
# initramfs loads that module, and merely shipping the .ko is not enough:
# dracut has to modprobe it. Without this, dracut spins in initqueue until
# it times out and nothing is ever written to disk -- which is exactly
# what a booted card showed: zero journal files, machine-id still
# "uninitialized", and an ext4 whose last mount was the build host.
#
# This is also why every qemu test passed. `-M raspi4b` is a Pi 4, so it
# took the builtin sdhci-iproc path and never exercised this at all.
#
# `bootc` is deliberately NOT in add_dracutmodules. AlmaLinux's working
# image ships the 51bootc module on disk but its check() returns 255 so it
# stays out of the initramfs, and forcing it in here was wrong: 51bootc's
# install() ends on a test for /usr/lib/composefs/setup-root-conf.toml,
# which this image does not have, so install() returns 1 and we end up
# with a half-installed module plus a second root-setup path racing
# ostree-prepare-root. Match AlmaLinux and leave it out.
RUN install -d /usr/lib/dracut/dracut.conf.d && \
    printf '%s\n' \
        'systemdsystemconfdir=/etc/systemd/system' \
        'systemdsystemunitdir=/usr/lib/systemd/system' \
        > /usr/lib/dracut/dracut.conf.d/30-archlinux-bootc-module.conf && \
    printf '%s\n' \
        'reproducible=yes' \
        'hostonly=no' \
        'compress=zstd' \
        'add_dracutmodules+=" ostree "' \
        'force_drivers+=" sdhci-of-dwcmshc "' \
        > /usr/lib/dracut/dracut.conf.d/30-archlinux-bootc-container-build.conf

# /run/systemd/resolve/resolv.conf is a live bind mount under emulated
# builds and can't be rm'd ("device or resource busy") -- harmless to
# leave, /run is tmpfs at real boot regardless.
RUN sed -i 's|^HOME=.*|HOME=/var/home|' /etc/default/useradd && \
    printf 'uninitialized\n' > /etc/machine-id && \
    systemctl mask systemd-firstboot.service && \
    rm -rf \
        /home \
        /root \
        /tmp \
        /usr/local \
        /srv \
        /opt \
        /mnt \
        /var \
        /usr/lib/sysimage/log \
        /usr/lib/sysimage/cache/pacman/pkg && \
    { find /run -mindepth 1 -maxdepth 1 ! -name .containerenv -exec rm -rf -- {} + || true; } && \
    install -d /sysroot /run /usr/lib/ostree /var && \
    install -d -m 1777 /tmp && \
    ln -sT sysroot/ostree /ostree && \
    ln -sT var/roothome /root && \
    ln -sT var/srv /srv && \
    ln -sT var/opt /opt && \
    ln -sT var/mnt /mnt && \
    ln -sT var/home /home && \
    ln -sT ../var/usrlocal /usr/local && \
    printf '%s\n' \
        'd /var/opt 0755 root root -' \
        'd /var/home 0755 root root -' \
        'd /var/srv 0755 root root -' \
        'd /var/mnt 0755 root root -' \
        'd /var/usrlocal 0755 root root -' \
        'd /var/roothome 0700 root root -' \
        'd /run/media 0755 root root -' \
        > /usr/lib/tmpfiles.d/bootc-base-dirs.conf

# One network stack, not two. ALARM's base enables systemd-networkd and
# ships /etc/systemd/network/{en,eth}.network, both `DHCP=yes` matching
# `en*`/`eth*` -- and the Pi 5's onboard NIC is `end0`, so it matches.
# Left alone, networkd and NetworkManager would both run a DHCP client on
# the same interface. Worse, both wait-online units end up enabled, so
# network-online.target blocks on systemd-networkd-wait-online for its
# full timeout on any boot with no ethernet plugged in -- which is the
# normal case for this board, since it's provisioned for wifi.
#
# NetworkManager is the stack here (provision-secrets.sh writes an
# .nmconnection), so disable and mask networkd and drop ALARM's profiles.
# systemd-resolved stays: NetworkManager integrates with it deliberately.
RUN rm -f /etc/systemd/network/en.network /etc/systemd/network/eth.network && \
    systemctl --no-reload disable \
        systemd-networkd.service \
        systemd-networkd.socket \
        systemd-networkd-wait-online.service && \
    systemctl --no-reload mask \
        systemd-networkd.service \
        systemd-networkd.socket \
        systemd-networkd-wait-online.service && \
    test ! -e /etc/systemd/system/multi-user.target.wants/systemd-networkd.service && \
    test ! -e /etc/systemd/system/network-online.target.wants/systemd-networkd-wait-online.service

# ostree backend, not composefs backend -- different things. `[composefs]
# enabled = yes` here is ostree-internal (deployment checkouts stored as
# composefs images) and still uses /ostree/repo, /sysroot/ostree/deploy,
# /boot/loader/entries/ostree-N.conf -- what the sync hook reads. Confirmed
# against quay.io/almalinuxorg/almalinux-bootc-rpi:10, which ships this
# and boots real Pi 5 hardware. What conflicts with `--bootloader none` is
# bootc's separate `--composefs-backend` install flag, a different storage
# backend entirely -- never pass it, and never ship a UKI (which would
# auto-select it). See docs/TEAM-BRIEF.md and STATUS.md.
RUN printf '%s\n' \
        '[composefs]' \
        'enabled = yes' \
        '[sysroot]' \
        'readonly = true' \
        > /usr/lib/ostree/prepare-root.conf

# Build the initramfs HERE, not earlier. dracut's 50ostree module installs
# /usr/lib/ostree/prepare-root.conf into the initramfs only if the file
# already exists when dracut runs:
#
#   for r in /usr/lib /etc; do
#       test -f "$r/ostree/prepare-root.conf" && inst_simple ...
#
# and ostree-prepare-root reads the INITRAMFS copy at boot, not the one in
# /usr. Building before writing that file produced an initramfs with no
# prepare-root.conf at all, which silently fell back to the compiled-in
# default (composefs `maybe`, sysroot not readonly) -- so every composefs
# and readonly setting in this file was inert on real hardware. Confirmed
# by unpacking both our initramfs and AlmaLinux's: theirs contains the
# file, ours did not.
# --mount=type=tmpfs,dst=/var/tmp because the cleanup step above removes
# /var, and dracut refuses to start without a usable tmpdir. A tmpfs keeps
# it out of the committed image.
RUN --mount=type=tmpfs,dst=/var/tmp \
    kernel_dir="$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d | sort -V | tail -1)" && \
    test -n "$kernel_dir" && \
    dracut --force "${kernel_dir}/initramfs.img" && \
    lsinitrd "${kernel_dir}/initramfs.img" | grep -q 'ostree/prepare-root.conf'

# Size trim. Every removal here was checked against `pacman -Qi <pkg>`
# "Required By" plus readelf -d / strings on the actual linked binaries
# before it went in -- see the report this RUN was written for. Nothing
# on the MUST-NOT-REMOVE list (linux-rpi, ostree, skopeo, bubblewrap,
# dracut, systemd, networkmanager, openssh, sudo, e2fsprogs, dosfstools,
# glib2/openssl/zstd, podman) is touched.
#
# criu / python-protobuf / protobuf / abseil-cpp / python: crun's pacman
# metadata lists criu as a hard Depends On, but libcrun.so only
# dlopen()s libcriu.so.2 at runtime for optional checkpoint/restore --
# confirmed with `readelf -d` (no NEEDED entry) and the dlopen/"could not
# load" strings in libcrun.so itself. python-protobuf exists only to
# support criu's RPC config parsing, and nothing else in this image's
# package set needs python or protobuf. Force-remove: pacman's dependency
# graph is stale here, the ELF graph isn't.
#
# binutils / mkinitcpio / libmakepkg-dropins: linux-rpi hard-depends on
# mkinitcpio for its kernel pacman hooks, but this image builds its
# initramfs with dracut and never invokes mkinitcpio. binutils is pulled
# in only as mkinitcpio/libmakepkg-dropins' own dependency; nothing that
# actually runs on the deployed system links or shells out to it.
#
# gettext: no binary in this image links libintl.so -- there isn't one on
# Arch, glibc supplies gettext() natively on Linux (confirmed with
# `readelf -d` across podman, skopeo, ostree, systemd, NetworkManager).
# pacman's own Depends On lists it, but only for translating pacman's CLI
# messages; removing it loses translated strings, not function. Its own
# dependents libxml2/icu are left alone: libarchive also depends on
# libxml2 and is pacman's and podman's real archive backend, so that
# chain is genuinely load-bearing.
RUN --mount=type=tmpfs,dst=/tmp \
    pacman -Rdd --noconfirm \
        criu python-protobuf protobuf abseil-cpp python \
        mkinitcpio libmakepkg-dropins binutils \
        gettext

# Headers, man/doc/info pages and static archives are compile-time or
# documentation-time artifacts; nothing reads them at runtime, and pacman
# doesn't verify file presence for already-installed packages. Locale
# catalogs are trimmed to en_US (a 4 KiB stub -- English strings need no
# translation, so there is effectively nothing to keep) plus the alias
# file glibc's own lookups consult.
RUN rm -rf /usr/include /usr/share/man /usr/share/doc /usr/share/info && \
    find /usr/lib -name '*.a' -delete && \
    find /usr/lib -name '*.h' -delete && \
    find /usr/share/locale -mindepth 1 -maxdepth 1 \
        ! -name 'en_US' ! -name 'locale.alias' -exec rm -rf {} +

LABEL containers.bootc=1
LABEL org.opencontainers.image.source="https://github.com/oci-native/archlinux-rpi"

# --skip var-tmpfiles --skip utf8: bootc-dev/bootc#1481, still open.
# ENOSYS under qemu-user emulation (host is x86_64). Re-run unskipped on
# real Pi hardware once it exists.
RUN bootc container lint --skip var-tmpfiles --skip utf8
