# aarch64 bootc builder stage, cross-compiled.
#
# Sibling of /home/bupd/Projects/archlinux/Containerfile.base's bootc-builder
# stage. That stage builds bootc for x86_64 natively. This one builds it for
# aarch64 on the same x86_64 host without ever executing aarch64 code during
# the build -- see docs/bootc-build.md for the full reasoning, the version
# pin, and the wall-clock measurement.
#
# Meant to be pasted into (or COPY --from=)'d by the Pi Containerfile, next
# to alarm-sysroot.conf which must sit alongside this file.

FROM --platform=$BUILDPLATFORM docker.io/archlinux/archlinux:latest AS bootc-cross-builder

ARG BOOTC_VERSION=v1.16.10

RUN sed -i '/^[[:space:]]*DownloadUser[[:space:]]/d' /etc/pacman.conf

# Native (x86_64) tooling:
#   - aarch64-linux-gnu-{gcc,binutils}: the official Arch cross toolchain,
#     used only as a compiler/assembler/linker driver -- its own bundled
#     glibc is deliberately not what gets linked into the binary, see below.
#   - rustup: pacman's plain `rust` package ships only the host-target std
#     library. rustup adds the aarch64-unknown-linux-gnu std component.
#     Arch's own rustup package lists aarch64-linux-gnu-gcc as the intended
#     companion for aarch64-unknown-linux-* targets, so this is the
#     distro-sanctioned pairing, not an improvised one.
#   - glib2, ostree, openssl, zstd (native): bootc's build tooling (xtask,
#     used below to generate man pages) runs on the host and links these
#     the ordinary way, same packages Containerfile.base installs.
RUN pacman -Syu --needed --noconfirm \
        aarch64-linux-gnu-binutils \
        aarch64-linux-gnu-gcc \
        bsdtar \
        curl \
        gcc \
        git \
        glib2 \
        go-md2man \
        make \
        openssl \
        ostree \
        pkgconf \
        rustup \
        zstd

RUN rustup toolchain install stable --profile minimal && \
    rustup default stable && \
    rustup target add aarch64-unknown-linux-gnu

# ---------------------------------------------------------------------------
# aarch64 sysroot, assembled from real ALARM packages.
#
# The cross toolchain's bundled glibc (aarch64-linux-gnu-glibc) tracks
# mainline Arch, which runs ahead of ALARM's own glibc build. Linking against
# the toolchain's glibc risks a binary that requires GLIBC_x.yy symbol
# versions the Pi image's actual libc.so.6 doesn't carry -- it would build
# clean here and refuse to run there. So the toolchain is used purely as a
# compiler/linker driver, pointed at a --sysroot built from the same ostree,
# glib2, openssl, zstd, and (transitively) glibc packages the final image
# installs from ALARM.
#
# This is metadata and file extraction, not execution: pacman runs as a
# native x86_64 process against a throwaway --root/--dbpath, -Sw only
# downloads (no scriptlet from any of these packages ever runs), and bsdtar
# just unpacks archive members. No aarch64 code executes during any of this.
COPY alarm-sysroot.conf /etc/alarm-sysroot.conf
RUN mkdir -p /sysroot-aarch64/var/lib/pacman /sysroot-aarch64/var/cache/pacman/pkg && \
    pacman --config /etc/alarm-sysroot.conf \
        --root /sysroot-aarch64 --dbpath /sysroot-aarch64/var/lib/pacman \
        --cachedir /sysroot-aarch64/var/cache/pacman/pkg \
        -Sy && \
    pacman --config /etc/alarm-sysroot.conf \
        --root /sysroot-aarch64 --dbpath /sysroot-aarch64/var/lib/pacman \
        --cachedir /sysroot-aarch64/var/cache/pacman/pkg \
        -Swu --noconfirm ostree glib2 openssl zstd && \
    for pkg in /sysroot-aarch64/var/cache/pacman/pkg/*.pkg.tar.xz; do \
        bsdtar -xpf "$pkg" -C /sysroot-aarch64 \
            --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL \
            --exclude 'usr/bin/*' --exclude 'usr/sbin/*' || true; \
    done && \
    rm -rf /sysroot-aarch64/var/lib/pacman /sysroot-aarch64/var/cache/pacman

RUN printf '%s\n' \
        '#!/bin/sh' \
        'exec aarch64-linux-gnu-gcc --sysroot=/sysroot-aarch64 "$@"' \
        > /usr/local/bin/aarch64-sysroot-gcc && \
    chmod +x /usr/local/bin/aarch64-sysroot-gcc

ENV PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_SYSROOT_DIR=/sysroot-aarch64 \
    PKG_CONFIG_PATH=/sysroot-aarch64/usr/lib/pkgconfig \
    CC_aarch64_unknown_linux_gnu=/usr/local/bin/aarch64-sysroot-gcc \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=/usr/local/bin/aarch64-sysroot-gcc

WORKDIR /tmp/bootc
RUN git clone --branch "${BOOTC_VERSION}" --depth 1 \
        https://github.com/bootc-dev/bootc.git .

# `make bin`'s manpages prerequisite shells out to xtask, which runs the
# built bootc binary to dump its CLI as JSON. That has to be a native
# x86_64 binary, so it's built and run here, before any cargo env below
# switches over to the aarch64 target.
RUN cargo run --release --package xtask -- manpages

# `make install`'s own `completion` prerequisite also runs the freshly
# built binary (`bootc completion <shell>`) to generate shell completions.
# For this build that binary is aarch64, and running it here -- even under
# the registered qemu-aarch64 binfmt handler -- is exactly the "execute a
# freshly built aarch64 binary during an emulated build" the team's cross
# build rule forbids. Shell completions aren't load-bearing for an
# unattended appliance image, so this drops them rather than take that
# risk: the `completion` prerequisite and its five install lines are
# removed from a local copy of the Makefile.
RUN sed -i 's/^install: completion/install:/' Makefile && \
    sed -i '/target\/completion\/bootc\./d' Makefile

# The cross build itself. Serialize codegen and skip LTO/debuginfo for the
# same reason Containerfile.base does: upstream's release profile enables
# thin LTO and full debug info, and the final link can exceed what rootless
# Podman hands the build, drawing an OOM kill from the host. That's link-time
# memory pressure, architecture-independent, so the guards carry over as-is.
ENV CARGO_BUILD_JOBS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    CARGO_PROFILE_RELEASE_LTO=false
RUN cargo build --release --target aarch64-unknown-linux-gnu --bins && \
    rm -rf target/release && \
    ln -s aarch64-unknown-linux-gnu/release target/release && \
    make install-all DESTDIR=/output

# install-all also emits bootc's development integration-test executable and
# keeps full Rust debug sections. Neither belongs in the deployed OS image.
# Use the cross binutils' strip, not the host's, even though host strip can
# often handle foreign-arch ELF too -- no reason to rely on "often" here.
RUN rm -f /output/usr/bin/bootc-integration-tests && \
    aarch64-linux-gnu-strip --strip-unneeded \
        /output/usr/bin/bootc \
        /output/usr/bin/system-reinstall-bootc

# Downstream (the aarch64 system stage) does:
#   COPY --from=bootc-cross-builder /output /
