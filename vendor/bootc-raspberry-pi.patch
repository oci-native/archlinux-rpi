From 092d5c4ad0784c07549896f169743851c92f35e9 Mon Sep 17 00:00:00 2001
From: Prasanth Baskar <prasanth@8gears.com>
Date: Sun, 13 Sep 2026 03:38:48 +0530
Subject: [PATCH 2/3] fixup: Use run_capture_stderr and cover the new match arm

CommandRunExt has no bare run(); the umount uses run_capture_stderr. The
Bootloader match in the composefs status path became non-exhaustive, so it
gets an arm that points at Bootloader::kind(), which is where the composefs
backend is actually rejected for the Pi.

Signed-off-by: Prasanth Baskar <prasanth@8gears.com>
---
 crates/lib/src/bootc_composefs/status.rs | 6 ++++++
 crates/lib/src/bootloader.rs             | 2 +-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/crates/lib/src/bootc_composefs/status.rs b/crates/lib/src/bootc_composefs/status.rs
index 33c323b..d9f63f1 100644
--- a/crates/lib/src/bootc_composefs/status.rs
+++ b/crates/lib/src/bootc_composefs/status.rs
@@ -336,6 +336,12 @@ fn get_sorted_type1_boot_entries_helper(
             Bootloader::None => {
                 unreachable!("Bootloader checked during installation should not have been none")
             }
+            // The Pi firmware does not read BLS entries, so it has no boot
+            // menu to order; the composefs backend is rejected for it in
+            // Bootloader::kind().
+            Bootloader::RaspberryPi => {
+                unreachable!("The raspberry-pi bootloader is not supported with the composefs backend")
+            }
         };
 
         if ascending { ord } else { ord.reverse() }
diff --git a/crates/lib/src/bootloader.rs b/crates/lib/src/bootloader.rs
index 31ac8e4..9145f6b 100644
--- a/crates/lib/src/bootloader.rs
