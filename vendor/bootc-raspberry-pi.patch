From 71ed1476015c7db207b436bf09435b0573b53a57 Mon Sep 17 00:00:00 2001
From: Prasanth Baskar <prasanth@8gears.com>
Date: Sun, 13 Sep 2026 03:55:35 +0530
Subject: [PATCH 3/3] fixup: Mount the firmware partition at <root>/boot/efi

The baseline installer runs mkfs.fat on the ESP and creates <boot>/efi, but
never mounts it, so the backend has to. Doing it inside the target tree rather
than under /run matches the bootupd path and leaves the firmware partition
visible to anything inspecting the target afterwards.

Signed-off-by: Prasanth Baskar <prasanth@8gears.com>
---
 crates/lib/src/bootloader.rs | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/crates/lib/src/bootloader.rs b/crates/lib/src/bootloader.rs
index 9145f6b..63c4c75 100644
--- a/crates/lib/src/bootloader.rs
+++ b/crates/lib/src/bootloader.rs
@@ -806,9 +806,12 @@ pub(crate) fn install_via_raspberrypi(
     })?;
     let esp_path = esp.path();
 
-    // Mounted somewhere of our own rather than relying on /boot/efi, so this
-    // behaves identically at install time and when re-syncing later.
-    let fw = Utf8PathBuf::from("/run/bootc/rpi-firmware");
+    // The baseline installer runs mkfs.fat on the ESP and creates <boot>/efi,
+    // but does not mount it, so mount it here. Keeping it inside the target
+    // tree rather than somewhere under /run matches what the bootupd path
+    // does and means the firmware partition is visible to anything that looks
+    // at the target afterwards.
+    let fw = root_path.join("boot").join(EFI_DIR);
     create_dir_all(fw.as_std_path()).with_context(|| format!("Creating {fw}"))?;
     mount::mount(&esp_path, &fw)?;
 
