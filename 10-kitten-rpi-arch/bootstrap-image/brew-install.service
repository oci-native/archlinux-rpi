# First-boot Homebrew install. Lives in the bootstrap (cloud-init) image
# because the installer refuses to run as root and needs the alarm user,
# which cloud-init creates on first boot. Installs to
# /home/linuxbrew/.linuxbrew (backed by /var/home, so it survives bootc
# upgrades). Hooked into cloud-init.target, not multi-user.target: cloud-final
# orders itself after multi-user, so wanting this from multi-user while
# ordering after cloud-final is a cycle systemd breaks by dropping the job.
# Caveat: Homebrew on arm64 Linux is beta; some formulae build
# from source or lack bottles.
[Unit]
Description=Install Homebrew on first boot
Wants=network-online.target
After=network-online.target cloud-final.service
ConditionPathExists=!/home/linuxbrew/.linuxbrew/bin/brew

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=60min
# The script is saved to a file first: handing it to sudo -i as one
# argument re-quotes the whole thing for the login shell, and under systemd
# (no tty, empty stdin) that produced a silent exit 0 with nothing installed.
ExecStart=/usr/bin/curl --retry 5 -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o /run/brew-install.sh
ExecStart=/usr/bin/sudo -u alarm -H /usr/bin/env NONINTERACTIVE=1 /usr/bin/bash /run/brew-install.sh

[Install]
WantedBy=cloud-init.target
